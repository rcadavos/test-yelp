# Public site URL (HTTPS in production) — used for metadataBase / Open Graph
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Copy to .env.local and adjust.

# Max 40000 (meters). ~8047 m ≈ 5 miles
DEFAULT_SEARCH_RADIUS_METERS=8047

# Yelp Fusion / Places API (server-only — required for search)
YELP_API_KEY=
